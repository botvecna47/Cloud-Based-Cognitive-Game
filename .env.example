# ==============================================================================
# MOUNT ADEPT: SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace with your actual Supabase project keys
# Found in: Supabase Dashboard -> Settings -> API
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public API Key (safe for browser usage with Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
