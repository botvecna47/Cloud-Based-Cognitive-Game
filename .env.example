# ==============================================================================
# GAMEFIED APTI: SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace with your actual Supabase project keys
# Found in: Supabase Dashboard -> Project Settings -> API Keys
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Public API Key (safe for browser usage with RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
